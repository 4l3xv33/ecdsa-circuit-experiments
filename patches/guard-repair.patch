+//! Exact factoring of nearby Toffoli gates with a shared control and target.
+//!
+//! CCX(a,b,t); CCX(a,c,t) equals CX(b,c); CCX(a,c,t); CX(b,c):
+//! a*b XOR a*c = a*(b XOR c). All four wires are distinct. The borrowed
+//! control c is restored, including when it starts dirty or entangled.
+//! Every replacement inherits the same classical condition. Adjacency means
+//! the surrounding condition stack is also unchanged. No phase gates,
+//! measurements, fresh qubits, or input-dependent assumptions are introduced.
+
+use crate::circuit::{Op, OperationType as K, NO_BIT, NO_QUBIT, NO_REG};
+
+fn replacement(left: Op, right: Op) -> Option<[Op; 3]> {
+    if left.kind != K::CCX || right.kind != K::CCX
+        || left.q_target != right.q_target
+        || left.c_condition != right.c_condition
+    {
+        return None;
+    }
+    for op in [left, right] {
+        if op.c_target != NO_BIT || op.r_target != NO_REG
+            || [op.q_control1, op.q_control2, op.q_target].contains(&NO_QUBIT)
+            || op.q_control1 == op.q_control2
+            || op.q_target == op.q_control1 || op.q_target == op.q_control2
+        {
+            return None;
+        }
+    }
+    let a = [left.q_control1, left.q_control2];
+    let b = [right.q_control1, right.q_control2];
+    let common = a.iter().copied().find(|q| b.contains(q))?;
+    let other_left = a.iter().copied().find(|q| *q != common)?;
+    let other_right = b.iter().copied().find(|q| *q != common)?;
+    if other_left == other_right { return None; }
+
+    let mut xor = Op::empty();
+    xor.kind = K::CX;
+    xor.q_control1 = other_left;
+    xor.q_target = other_right;
+    xor.c_condition = left.c_condition;
+    let mut product = left;
+    product.q_control1 = common;
+    product.q_control2 = other_right;
+    Some([xor, product, xor])
+}
+
+// Two controlled-X gates commute if neither target is a control of the
+// other. Their classical conditions are read-only throughout the window.
+// No phase, reset, measurement, bit write, or stack operation is crossed.
+fn commutes_with_ccx(middle: Op, right: Op) -> bool {
+    if !matches!(middle.kind, K::X | K::CX | K::CCX) { return false; }
+    if middle.q_target == right.q_control1 || middle.q_target == right.q_control2 { return false; }
+    if matches!(middle.kind, K::CX | K::CCX) && middle.q_control1 == right.q_target { return false; }
+    if middle.kind == K::CCX && middle.q_control2 == right.q_target { return false; }
+    true
+}
+
+fn find_pair(ops: &[Op], start: usize) -> Option<(usize, [Op; 3])> {
+    if ops[start].kind != K::CCX { return None; }
+    const WINDOW: usize = 32;
+    for end in start + 1..ops.len().min(start + WINDOW) {
+        if let Some(gates) = replacement(ops[start], ops[end]) {
+            if ops[start + 1..end].iter().all(|m| commutes_with_ccx(*m, ops[end])) {
+                return Some((end, gates));
+            }
+        }
+        if !matches!(ops[end].kind, K::X | K::CX | K::CCX) { break; }
+    }
+    None
+}
+
+pub(super) fn run(ops: Vec<Op>) -> Vec<Op> {
+    // Reserve the exact expansion so Vec never doubles a large op buffer.
+    let mut count = 0usize;
+    let mut scan = 0;
+    while scan + 1 < ops.len() {
+        if let Some((end, _)) = find_pair(&ops, scan) {
+            count += 1;
+            scan = end + 1;
+        } else {
+            scan += 1;
+        }
+    }
+    if count == 0 {
+        eprintln!("ADJACENT_FACTOR pairs=0 Toffoli_removed=0 extra_CNOTs=0");
+        return ops;
+    }
+    let mut out = Vec::with_capacity(ops.len() + count);
+    let mut i = 0;
+    let mut factored = 0usize;
+    while i < ops.len() {
+        if i + 1 < ops.len() {
+            if let Some((end, gates)) = find_pair(&ops, i) {
+                out.extend_from_slice(&gates);
+                out.extend_from_slice(&ops[i + 1..end]);
+                i = end + 1;
+                factored += 1;
+                continue;
+            }
+        }
+        out.push(ops[i]);
+        i += 1;
+    }
+    eprintln!("ADJACENT_FACTOR pairs={factored} Toffoli_removed={factored} extra_CNOTs={}", 2 * factored);
+    out
+}
+
