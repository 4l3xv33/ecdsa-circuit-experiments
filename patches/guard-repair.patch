+                                            let mut rng2 = Shake256::default().finalize_xof();
+                                            let mut original = Simulator::new(4, 2, &mut rng1);
+                                            let mut optimized = Simulator::new(4, 2, &mut rng2);
+                                            for q in 0..4 {
+                                                let value = if (state >> q) & 1 == 1 { u64::MAX } else { 0 };
+                                                original.qubits[q] = value;
+                                                optimized.qubits[q] = value;
+                                            }
+                                            for bit in 0..2 {
+                                                let value = if (bits >> bit) & 1 == 1 { u64::MAX } else { 0 };
+                                                original.bits[bit] = value;
+                                                optimized.bits[bit] = value;
+                                            }
+                                            let initial = optimized.qubits.clone();
+                                            let mut push = Op::empty();
+                                            push.kind = K::PushCondition;
+                                            push.c_condition = BitId(1);
+                                            let mut pop = Op::empty();
+                                            pop.kind = K::PopCondition;
+                                            original.apply_iter([push,left,right,pop].iter());
+                                            let forward = [push,replacement[0],replacement[1],replacement[2],pop];
+                                            optimized.apply_iter(forward.iter());
+                                            assert_eq!(original.qubits, optimized.qubits);
+                                            assert_eq!(original.bits, optimized.bits);
+                                            assert_eq!(original.phase, 0);
+                                            assert_eq!(optimized.phase, 0);
+                                            assert_eq!(original.stats.toffoli_gates, 2 * optimized.stats.toffoli_gates);
+                                            let inverse = [push,replacement[2],replacement[1],replacement[0],pop];
+                                            optimized.apply_iter(inverse.iter());
+                                            assert_eq!(optimized.qubits, initial);
+                                        }
+                                    }
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn rejects_unsafe_or_nonmatching_pairs() {
+        let left = ccx(0, 1, 3, NO_BIT);
+        for right in [ccx(0,2,4,NO_BIT), ccx(0,2,3,BitId(0)), ccx(0,1,3,NO_BIT), ccx(2,4,3,NO_BIT), ccx(0,3,3,NO_BIT)] {
+            assert!(replacement(left, right).is_none());
+        }
+        let mut phase_gate = ccx(0,2,3,NO_BIT);
+        phase_gate.kind = K::CCZ;
+        assert!(replacement(left, phase_gate).is_none());
+    }
+
+    #[test]
+    fn preserves_barriers_and_nonoverlapping_order() {
+        let left = ccx(0,1,3,NO_BIT);
+        let right = ccx(0,2,3,NO_BIT);
+        let mut barrier = Op::empty();
+        barrier.kind = K::BitStore0;
+        barrier.c_target = BitId(0);
+        let untouched = vec![left,barrier,right];
+        assert_eq!(run(untouched.clone()), untouched);
+        let expected = replacement(left,right).unwrap();
+        let result = run(vec![left,right,barrier,left,right]);
+        assert_eq!(result, [expected.as_slice(), &[barrier], expected.as_slice()].concat());
+    }
+
+    #[test]
+    fn exhaustive_commuting_windows() {
+        let left = ccx(0,1,3,BitId(0));
+        let right = ccx(0,2,3,BitId(0));
+        let mut checked = 0;
+        let mut moved = 0;
+        for kind in [K::X, K::CX, K::CCX] {
+            for target in 0..5 {
+                for a in 0..5 {
+                    for b in 0..5 {
+                        if (kind == K::X && (a != 0 || b != 0))
+                            || (kind == K::CX && (a == target || b != 0))
+                            || (kind == K::CCX && (a == b || a == target || b == target)) { continue; }
+                        let mut middle = Op::empty();
+                        middle.kind = kind;
+                        middle.q_target = QubitId(target);
+                        middle.c_condition = BitId(1);
+                        if kind != K::X { middle.q_control1 = QubitId(a); }
+                        if kind == K::CCX { middle.q_control2 = QubitId(b); }
+                        middle.validate();
+                        let original_ops = vec![left,middle,right];
+                        let optimized_ops = if commutes_with_ccx(middle,right) {
+                            assert!(find_pair(&original_ops,0).is_some());
+                            moved += 1;
+                            run(original_ops.clone())
+                        } else {
+                            assert!(find_pair(&original_ops,0).is_none());
+                            original_ops.clone()
+                        };
+                        for bits in 0..4u64 {
+                            for state in 0..32u64 {
+                                let mut rng1 = Shake256::default().finalize_xof();
+                                let mut rng2 = Shake256::default().finalize_xof();
+                                let mut original = Simulator::new(5,2,&mut rng1);
+                                let mut optimized = Simulator::new(5,2,&mut rng2);
+                                for q in 0..5 {
+                                    let v = if state >> q & 1 == 1 { u64::MAX } else { 0 };
+                                    original.qubits[q] = v;
+                                    optimized.qubits[q] = v;
+                                }
+                                for bit in 0..2 {
+                                    let v = if bits >> bit & 1 == 1 { u64::MAX } else { 0 };
+                                    original.bits[bit] = v;
+                                    optimized.bits[bit] = v;
+                                }
+                                let initial = optimized.qubits.clone();
+                                original.apply_iter(original_ops.iter());
+                                optimized.apply_iter(optimized_ops.iter());
+                                assert_eq!(original.qubits,optimized.qubits);
+                                assert_eq!(original.bits,optimized.bits);
+                                assert_eq!(optimized.phase,0);
+                                optimized.apply_iter(optimized_ops.iter().rev());
+                                assert_eq!(optimized.qubits,initial);
+                                checked += 1;
+                            }
+                        }
+                    }
+                }
+            }
+        }
+        assert!(moved > 0);
+        assert_eq!(checked,10880);
+    }
+}
