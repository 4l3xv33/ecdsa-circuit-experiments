+// Exact alternative to the per-rail (3,1) shift record.
+// Three exponents 0..7 with sum <= 10 have exactly 256 states. Complementing
+// all nine bits changes the sum s to 21-s; exactly one complement is allowed.
+// This file is included by leapfrog.rs, so it uses the existing Lin helpers.
+fn sr_tick(t: usize) -> bool { t >= 6 && a2_tick(t) && a2_tick((t / 6) * 6 + t % 2 + 4) }
+
+// AND DAG with exact constant/duplicate simplification and reverse MBU cleanup.
+#[derive(Default)]
+struct SrDag { recs: Vec<(QubitId, Lin, Lin)> }
+impl SrDag {
+    fn and(&mut self, c: &mut Builder, a: Lin, b: Lin) -> Lin {
+        if a.w.is_empty() { return if a.one { b } else { a }; }
+        if b.w.is_empty() { return if b.one { a } else { b }; }
+        if a.x(&b).w.is_empty() { return if a.one == b.one { a } else { Lin::k(false) }; }
+        let q = lin_and(c, &a, &b);
+        self.recs.push((q, a, b)); Lin::of(&[q])
+    }
+    fn maj(&mut self, c: &mut Builder, a: Lin, b: Lin, d: Lin) -> Lin {
+        self.and(c, a.x(&d), b.x(&d)).x(&d)
+    }
+    fn finish(mut self, c: &mut Builder) {
+        while let Some((q,a,b)) = self.recs.pop() { lin_and_erase(c,q,&a,&b); }
+    }
+}
+fn sr_not(a: &Lin) -> Lin { a.x(&Lin::k(true)) }
+fn sr_lit(a: Lit) -> Lin { match a { Lit::Zero => Lin::k(false), Lit::One => Lin::k(true), Lit::W(q,n) => Lin::of(&[q]).x(&Lin::k(n)) } }
+fn sr_and_into(c:&mut Builder,a:&Lin,b:&Lin,out:QubitId) {
+    if a.w.is_empty() {if a.one{lin_xor_into(c,b,out);}}
+    else if b.w.is_empty(){if b.one{lin_xor_into(c,a,out);}}
+    else if a.x(b).w.is_empty(){if a.one==b.one{lin_xor_into(c,a,out);}}
+    else{let(ha,hb)=lin_pair_on(c,a,b);c.ccx(ha,hb,out);lin_pair_off(c,a,b);}
+}
+fn sr_phase_lin(c:&mut Builder,a:&Lin,anchor:QubitId) {
+    for &q in &a.w{c.z_if(q,NO_BIT);}
+    if a.one{c.x(anchor);c.z_if(anchor,NO_BIT);c.x(anchor);c.z_if(anchor,NO_BIT);}
+}
+fn sr_phase_product(c:&mut Builder,a:&Lin,b:&Lin,anchor:QubitId) {
+    if a.w.is_empty(){if a.one{sr_phase_lin(c,b,anchor);}}
+    else if b.w.is_empty(){if b.one{sr_phase_lin(c,a,anchor);}}
+    else if a.x(b).w.is_empty(){if a.one==b.one{sr_phase_lin(c,a,anchor);}}
+    else{let(ha,hb)=lin_pair_on(c,a,b);c.cz(ha,hb);lin_pair_off(c,a,b);}
+}
+
+// out ^= [A+B+C >= 11]. C can be either 2 or 3 bits. Carry-save addition of
+// A+B+(C+5), then the carry into bit 4. Seven/eight CCX, respectively.
+fn sr_threshold(c: &mut Builder, a: [Lin;3], b: [Lin;3], cc: [Lin;3], out: QubitId) {
+    if a.iter().chain(b.iter()).all(|v|v.w.is_empty()&&!v.one) {return;}
+    let mut g = SrDag::default();
+    let z = g.and(c, cc[0].clone(), cc[1].clone());
+    let u = g.and(c, cc[2].clone(), z.clone());
+    let d = [sr_not(&cc[0]), cc[0].x(&cc[1]), sr_not(&cc[2].x(&z)), cc[2].x(&z).x(&u)];
+    let u1 = g.maj(c,a[0].clone(),b[0].clone(),d[0].clone());
+    let u2 = g.maj(c,a[1].clone(),b[1].clone(),d[1].clone());
+    let u3 = g.maj(c,a[2].clone(),b[2].clone(),d[2].clone());
+    let s1 = a[1].x(&b[1]).x(&d[1]);
+    let s2 = a[2].x(&b[2]).x(&d[2]);
+    let r2 = g.and(c,s1,u1);
+    let r3 = g.maj(c,s2,u2,r2);
+    // Last carry is written directly to out to avoid retaining an eighth temp.
+    let aa = d[3].x(&r3); let bb = u3.x(&r3);
+    if aa.w.is_empty() || bb.w.is_empty() || aa.x(&bb).w.is_empty() {
+        let f = g.and(c,aa,bb).x(&r3); lin_xor_into(c,&f,out);
+    } else {
+        let (ha,hb)=lin_pair_on(c,&aa,&bb); c.ccx(ha,hb,out); lin_pair_off(c,&aa,&bb); lin_xor_into(c,&r3,out);
+    }
+    g.finish(c);
+}
+fn sr_digit(q: [QubitId;3]) -> [Lin;3] { q.map(|q|Lin::of(&[q])) }
+
+// Retained-DAG form for the choice, whose subsequent gates still need raw.
+fn sr_threshold_form(c:&mut Builder,g:&mut SrDag,a:[Lin;3],b:[Lin;3],cc:[Lin;3])->Lin {
+    if a.iter().chain(b.iter()).all(|v|v.w.is_empty()&&!v.one) {return Lin::k(false);}
+    let z=g.and(c,cc[0].clone(),cc[1].clone());let u=g.and(c,cc[2].clone(),z.clone());
+    let d=[sr_not(&cc[0]),cc[0].x(&cc[1]),sr_not(&cc[2].x(&z)),cc[2].x(&z).x(&u)];
+    let u1=g.maj(c,a[0].clone(),b[0].clone(),d[0].clone());
+    let u2=g.maj(c,a[1].clone(),b[1].clone(),d[1].clone());
+    let u3=g.maj(c,a[2].clone(),b[2].clone(),d[2].clone());
+    let r2=g.and(c,a[1].x(&b[1]).x(&d[1]),u1);
+    let r3=g.maj(c,a[2].x(&b[2]).x(&d[2]),u2,r2);
+    g.maj(c,d[3].clone(),u3,r3)
+}
+
+#[derive(Clone,Default)]
+struct SrGroup {
+    low: [Option<[QubitId;2]>;3],
+    high: [Option<QubitId>;3],
+    measured: Option<crate::circuit::BitId>,
+}
+thread_local! {
+    static SR_GROUPS: std::cell::RefCell<std::collections::HashMap<usize,SrGroup>> = std::cell::RefCell::new(std::collections::HashMap::new());
+}
+fn sr_open(c: &mut Builder,t:usize) {
+    let q=c.alloc_qubit();
+    SR_GROUPS.with(|m|{let mut m=m.borrow_mut();let f=m.entry(a2_tid(t)).or_default();let j=a2_pos(t)-1;assert!(f.high[j].replace(q).is_none());});
+}
+fn sr_high(t:usize)->QubitId { SR_GROUPS.with(|m|m.borrow()[&a2_tid(t)].high[a2_pos(t)-1].unwrap()) }
+fn sr_register(c:&mut Builder,t:usize,k1:QubitId,k2:QubitId) {
+    SR_GROUPS.with(|m| {let mut m=m.borrow_mut(); let f=m.get_mut(&a2_tid(t)).unwrap();assert!(f.low[a2_pos(t)-1].replace([k1,k2]).is_none());});
+    sr_pack(c,t);
+}
+fn sr_z(f:&SrGroup)->[QubitId;8] {
+    let a=f.low[0].unwrap();let b=f.low[1].unwrap();let d=f.low[2].unwrap();
+    [a[0],a[1],f.high[0].unwrap(),b[0],b[1],f.high[1].unwrap(),d[0],d[1]]
+}
+fn sr_pack(c:&mut Builder,t:usize) {
+    if !sr_tick(t) {return;}
+    let f=SR_GROUPS.with(|m|m.borrow()[&a2_tid(t)].clone());
