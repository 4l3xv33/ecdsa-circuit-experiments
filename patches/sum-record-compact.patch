+fn sr_raw(c:&mut Builder,z:&[QubitId])->(SrDag,[Lin;3],Lin) {
+    let mut g=SrDag::default();let cap=z.len()-2;assert!((2..=8).contains(&cap));
+    let mut p=vec![Lin::k(true),sr_not(&Lin::of(&[z[2]]))];
+    for i in 3..=8 {let v=if i<=cap{g.and(c,p.last().unwrap().clone(),sr_not(&Lin::of(&[z[i]])))}else{p.last().unwrap().clone()};p.push(v);}
+    let raw=[p.iter().fold(Lin::k(false),|a,b|a.x(b)),p[1].x(&p[3]).x(&p[5]).x(&p[7]),p[3].x(&p[7])];
+    (g,raw,sr_not(&p[7]))
+}
+fn sr_veto(c:&mut Builder,z:&[QubitId],nf:QubitId,ad:QubitId,y:&Lin)->(SrDag,Lin) {
+    let mut g=SrDag::default();let z2=Lin::of(&[z[2]]);
+    let bad2=g.and(c,z2.clone(),Lin::of(&[nf]));
+    let v3=if z.len()-2>=3{g.and(c,sr_not(&z2),Lin::of(&[z[3]]))}else{Lin::k(false)};
+    let bad3=g.and(c,v3,Lin::of(&[ad]));
+    let q=g.and(c,Lin::of(&[*z.last().unwrap()]),sr_not(y));
+    let veto=g.and(c,q,bad2.x(&bad3));(g,veto)
+}
+// Low-space form for the last N2 rails-only steps. The output digit wires
+// temporarily hold the unconditional raw exponent, so the six valuation
+// helpers can leave before the budget arithmetic. Recomputing that short
+// prefix costs gates but avoids increasing the full circuit's qubit peak.
+fn sr_choice_low(c:&mut Builder,z:&[QubitId],nf:QubitId,ad:QubitId,y:Lin,prefix:[[Lin;3];2],outs:Option<(QubitId,QubitId,QubitId,QubitId)>) {
+    let digits=match outs{Some((_,a,b,d))=>[a,b,d],None=>[c.alloc_qubit(),c.alloc_qubit(),c.alloc_qubit()]};
+    let (g,raw,valid)=sr_raw(c,z);
+    for (f,q) in raw.iter().zip(digits){lin_xor_into(c,f,q);}
+    if let Some((out,_,_,_))=outs{lin_xor_into(c,&valid,out);}else{sr_phase_lin(c,&valid.x(&Lin::of(&[z[1]])),z[1]);}
+    g.finish(c);
+    let over=c.alloc_qubit();sr_threshold(c,prefix[0].clone(),prefix[1].clone(),sr_digit(digits),over);
+    let (vg,veto)=sr_veto(c,z,nf,ad,&y);
+    let ov=Lin::of(&[over]);
+    // Both veto and over imply valid. Thus D = valid XOR veto XOR over XOR
+    // veto*over. All sources remain unchanged until their cleanup finishes.
+    if let Some((out,_,_,_))=outs{lin_xor_into(c,&veto.x(&ov),out);sr_and_into(c,&veto,&ov,out);}
+    else{sr_phase_lin(c,&veto.x(&ov),z[1]);sr_phase_product(c,&veto,&ov,z[1]);}
+    vg.finish(c);
+    sr_threshold(c,prefix[0].clone(),prefix[1].clone(),sr_digit(digits),over);c.release_clean(over);
+    let (g,raw,_)=sr_raw(c,z);
+    if let Some((out,_,_,_))=outs{
+        for (f,q) in raw.iter().zip(digits){sr_and_into(c,&sr_not(&Lin::of(&[out])),f,q);}
+        c.cx(z[1],out);
+    }else{for(f,q)in raw.iter().zip(digits){lin_xor_into(c,f,q);c.release_clean(q);}}
+    g.finish(c);
+}
+
+// Core choice oracle. z is the existing low-bit deep-candidate transform.
+// This keeps the pinned window/flag preference, changing only admissibility.
+fn sr_choice_z(c:&mut Builder,z:&[QubitId],not_flipped:QubitId,added:QubitId,y:Lin,prefix:[[Lin;3];2],outs:Option<(QubitId,QubitId,QubitId,QubitId)>) {
+    let mut g=SrDag::default();
+    let mut p:Vec<Lin>=vec![Lin::k(true),sr_not(&Lin::of(&[z[2]]))];
+    let cap=z.len()-2;assert!((2..=8).contains(&cap));
+    for i in 3..=8 {let v=if i<=cap{g.and(c,p.last().unwrap().clone(),sr_not(&Lin::of(&[z[i]])))}else{p.last().unwrap().clone()};p.push(v);}
+    // p[j-1] is P_j, P_1=1, P_j=AND(!z_2,...,!z_j).
+    let raw=[p.iter().fold(Lin::k(false),|a,b|a.x(b)),p[1].x(&p[3]).x(&p[5]).x(&p[7]),p[3].x(&p[7])];
+    let valid=sr_not(&p[7]);
+    let over=sr_threshold_form(c,&mut g,prefix[0].clone(),prefix[1].clone(),raw.clone());
+    let v2=sr_not(&p[1]);let v3=p[1].x(&p[2]);
+    let bad2=g.and(c,v2,Lin::of(&[not_flipped]));
+    let bad3=g.and(c,v3,Lin::of(&[added]));
+    let q=g.and(c,Lin::of(&[*z.last().unwrap()]),sr_not(&y));
+    let veto=g.and(c,q,bad2.x(&bad3));
+    // A veto only occurs at v=2 or 3, both valid: valid & !veto = valid XOR veto.
+    let deep=g.and(c,valid.x(&veto),sr_not(&over));
+    match outs {
+        Some((o,k1,k2,k3))=>{lin_xor_into(c,&deep.x(&Lin::of(&[z[1]])),o);
+            for (raw,k) in raw.iter().zip([k1,k2,k3]) {sr_and_into(c,&deep,raw,k);}
+        }
+        None=>{let v=deep.x(&Lin::of(&[z[1]]));for q in v.w {c.z_if(q,NO_BIT);}if v.one{c.x(z[1]);c.z_if(z[1],NO_BIT);c.x(z[1]);c.z_if(z[1],NO_BIT);}}
+    }
+    // Every helper retains its parents until its own MBU phase is removed.
+    g.finish(c);
+}
