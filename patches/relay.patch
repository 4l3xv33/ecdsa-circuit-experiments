+//! Exact factoring of nearby Toffoli gates with a shared control and target.
+//!
+//! CCX(a,b,t); CCX(a,c,t) equals CX(b,c); CCX(a,c,t); CX(b,c):
+//! a*b XOR a*c = a*(b XOR c). All four wires are distinct. The borrowed
+//! control c is restored, including when it starts dirty or entangled.
+//! Every replacement inherits the same classical condition. Adjacency means
+//! the surrounding condition stack is also unchanged. No phase gates,
+//! measurements, fresh qubits, or input-dependent assumptions are introduced.
+
+use crate::circuit::{Op, OperationType as K, NO_BIT, NO_QUBIT, NO_REG};
+
+fn replacement(left: Op, right: Op) -> Option<[Op; 3]> {
+    if left.kind != K::CCX || right.kind != K::CCX
+        || left.q_target != right.q_target
+        || left.c_condition != right.c_condition
+    {
+        return None;
+    }
+    for op in [left, right] {
+        if op.c_target != NO_BIT || op.r_target != NO_REG
+            || [op.q_control1, op.q_control2, op.q_target].contains(&NO_QUBIT)
+            || op.q_control1 == op.q_control2
+            || op.q_target == op.q_control1 || op.q_target == op.q_control2
+        {
+            return None;
+        }
+    }
+    let a = [left.q_control1, left.q_control2];
+    let b = [right.q_control1, right.q_control2];
+    let common = a.iter().copied().find(|q| b.contains(q))?;
+    let other_left = a.iter().copied().find(|q| *q != common)?;
+    let other_right = b.iter().copied().find(|q| *q != common)?;
+    if other_left == other_right { return None; }
+
+    let mut xor = Op::empty();
+    xor.kind = K::CX;
+    xor.q_control1 = other_left;
+    xor.q_target = other_right;
+    xor.c_condition = left.c_condition;
+    let mut product = left;
+    product.q_control1 = common;
+    product.q_control2 = other_right;
+    Some([xor, product, xor])
+}
+
+// Two controlled-X gates commute if neither target is a control of the
+// other. Their classical conditions are read-only throughout the window.
+// No phase, reset, measurement, bit write, or stack operation is crossed.
+fn commutes_with_ccx(middle: Op, right: Op) -> bool {
+    if !matches!(middle.kind, K::X | K::CX | K::CCX) { return false; }
+    if middle.q_target == right.q_control1 || middle.q_target == right.q_control2 { return false; }
+    if matches!(middle.kind, K::CX | K::CCX) && middle.q_control1 == right.q_target { return false; }
+    if middle.kind == K::CCX && middle.q_control2 == right.q_target { return false; }
+    true
+}
+
+fn find_pair(ops: &[Op], start: usize) -> Option<(usize, [Op; 3])> {
+    if ops[start].kind != K::CCX { return None; }
+    const WINDOW: usize = 32;
+    for end in start + 1..ops.len().min(start + WINDOW) {
+        if let Some(gates) = replacement(ops[start], ops[end]) {
+            if ops[start + 1..end].iter().all(|m| commutes_with_ccx(*m, ops[end])) {
+                return Some((end, gates));
+            }
+        }
+        if !matches!(ops[end].kind, K::X | K::CX | K::CCX) { break; }
+    }
+    None
+}
+
+pub(super) fn run(ops: Vec<Op>) -> Vec<Op> {
+    // Reserve the exact expansion so Vec never doubles a large op buffer.
+    let mut count = 0usize;
+    let mut scan = 0;
+    while scan + 1 < ops.len() {
+        if let Some((end, _)) = find_pair(&ops, scan) {
+            count += 1;
+            scan = end + 1;
+        } else {
+            scan += 1;
+        }
+    }
+    if count == 0 {
+        eprintln!("ADJACENT_FACTOR pairs=0 Toffoli_removed=0 extra_CNOTs=0");
+        return ops;
+    }
+    let mut out = Vec::with_capacity(ops.len() + count);
+    let mut i = 0;
+    let mut factored = 0usize;
+    while i < ops.len() {
+        if i + 1 < ops.len() {
+            if let Some((end, gates)) = find_pair(&ops, i) {
+                out.extend_from_slice(&gates);
+                out.extend_from_slice(&ops[i + 1..end]);
+                i = end + 1;
+                factored += 1;
+                continue;
+            }
+        }
+        out.push(ops[i]);
+        i += 1;
+    }
+    eprintln!("ADJACENT_FACTOR pairs={factored} Toffoli_removed={factored} extra_CNOTs={}", 2 * factored);
+    out
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::circuit::{BitId, QubitId};
+    use crate::sim::Simulator;
+    use sha3::{digest::ExtendableOutput, Shake256};
+
+    fn ccx(a: u64, b: u64, target: u64, condition: BitId) -> Op {
+        let mut op = Op::empty();
+        op.kind = K::CCX;
+        op.q_control1 = QubitId(a);
+        op.q_control2 = QubitId(b);
+        op.q_target = QubitId(target);
+        op.c_condition = condition;
+        op
+    }
+
+    // This includes dirty borrowed controls, both target values, all control
+    // orderings, classical enable/disable, and a surrounding condition stack.
+    // Pure CX/CCX permutations have no phase terms: exhaustive basis equality
+    // therefore also establishes equality on arbitrary superpositions.
+    #[test]
+    fn exhaustive_basis_conditions_and_inverse() {
+        for a in 0..4 {
+            for b in 0..4 {
+                for c in 0..4 {
+                    for target in 0..4 {
+                        if a == b || a == c || a == target || b == c || b == target || c == target { continue; }
+                        for swapped_left in [false, true] {
+                            for swapped_right in [false, true] {
+                                for condition in [NO_BIT, BitId(0)] {
+                                    let left = if swapped_left { ccx(b,a,target,condition) } else { ccx(a,b,target,condition) };
+                                    let right = if swapped_right { ccx(c,a,target,condition) } else { ccx(a,c,target,condition) };
+                                    let replacement = replacement(left, right).expect("factorable");
+                                    for gate in replacement { gate.validate(); }
+                                    for bits in 0..4u64 {
+                                        for state in 0..16u64 {
+                                            let mut rng1 = Shake256::default().finalize_xof();
+                                            let mut rng2 = Shake256::default().finalize_xof();
+                                            let mut original = Simulator::new(4, 2, &mut rng1);
+                                            let mut optimized = Simulator::new(4, 2, &mut rng2);
+                                            for q in 0..4 {
+                                                let value = if (state >> q) & 1 == 1 { u64::MAX } else { 0 };
+                                                original.qubits[q] = value;
+                                                optimized.qubits[q] = value;
+                                            }
+                                            for bit in 0..2 {
+                                                let value = if (bits >> bit) & 1 == 1 { u64::MAX } else { 0 };
+                                                original.bits[bit] = value;
+                                                optimized.bits[bit] = value;
+                                            }
+                                            let initial = optimized.qubits.clone();
+                                            let mut push = Op::empty();
+                                            push.kind = K::PushCondition;
+                                            push.c_condition = BitId(1);
+                                            let mut pop = Op::empty();
+                                            pop.kind = K::PopCondition;
+                                            original.apply_iter([push,left,right,pop].iter());
+                                            let forward = [push,replacement[0],replacement[1],replacement[2],pop];
+                                            optimized.apply_iter(forward.iter());
+                                            assert_eq!(original.qubits, optimized.qubits);
+                                            assert_eq!(original.bits, optimized.bits);
+                                            assert_eq!(original.phase, 0);
+                                            assert_eq!(optimized.phase, 0);
+                                            assert_eq!(original.stats.toffoli_gates, 2 * optimized.stats.toffoli_gates);
+                                            let inverse = [push,replacement[2],replacement[1],replacement[0],pop];
+                                            optimized.apply_iter(inverse.iter());
+                                            assert_eq!(optimized.qubits, initial);
+                                        }
+                                    }
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn rejects_unsafe_or_nonmatching_pairs() {
+        let left = ccx(0, 1, 3, NO_BIT);
+        for right in [ccx(0,2,4,NO_BIT), ccx(0,2,3,BitId(0)), ccx(0,1,3,NO_BIT), ccx(2,4,3,NO_BIT), ccx(0,3,3,NO_BIT)] {
+            assert!(replacement(left, right).is_none());
+        }
+        let mut phase_gate = ccx(0,2,3,NO_BIT);
+        phase_gate.kind = K::CCZ;
+        assert!(replacement(left, phase_gate).is_none());
+    }
+
+    #[test]
+    fn preserves_barriers_and_nonoverlapping_order() {
+        let left = ccx(0,1,3,NO_BIT);
+        let right = ccx(0,2,3,NO_BIT);
+        let mut barrier = Op::empty();
+        barrier.kind = K::BitStore0;
+        barrier.c_target = BitId(0);
+        let untouched = vec![left,barrier,right];
+        assert_eq!(run(untouched.clone()), untouched);
+        let expected = replacement(left,right).unwrap();
+        let result = run(vec![left,right,barrier,left,right]);
+        assert_eq!(result, [expected.as_slice(), &[barrier], expected.as_slice()].concat());
+    }
+
+    #[test]
+    fn exhaustive_commuting_windows() {
+        let left = ccx(0,1,3,BitId(0));
+        let right = ccx(0,2,3,BitId(0));
+        let mut checked = 0;
+        let mut moved = 0;
+        for kind in [K::X, K::CX, K::CCX] {
+            for target in 0..5 {
+                for a in 0..5 {
+                    for b in 0..5 {
+                        if (kind == K::X && (a != 0 || b != 0))
+                            || (kind == K::CX && (a == target || b != 0))
+                            || (kind == K::CCX && (a == b || a == target || b == target)) { continue; }
+                        let mut middle = Op::empty();
+                        middle.kind = kind;
+                        middle.q_target = QubitId(target);
+                        middle.c_condition = BitId(1);
+                        if kind != K::X { middle.q_control1 = QubitId(a); }
+                        if kind == K::CCX { middle.q_control2 = QubitId(b); }
+                        middle.validate();
+                        let original_ops = vec![left,middle,right];
+                        let optimized_ops = if commutes_with_ccx(middle,right) {
+                            assert!(find_pair(&original_ops,0).is_some());
+                            moved += 1;
+                            run(original_ops.clone())
+                        } else {
+                            assert!(find_pair(&original_ops,0).is_none());
+                            original_ops.clone()
+                        };
+                        for bits in 0..4u64 {
+                            for state in 0..32u64 {
+                                let mut rng1 = Shake256::default().finalize_xof();
+                                let mut rng2 = Shake256::default().finalize_xof();
+                                let mut original = Simulator::new(5,2,&mut rng1);
+                                let mut optimized = Simulator::new(5,2,&mut rng2);
+                                for q in 0..5 {
+                                    let v = if state >> q & 1 == 1 { u64::MAX } else { 0 };
+                                    original.qubits[q] = v;
+                                    optimized.qubits[q] = v;
+                                }
+                                for bit in 0..2 {
+                                    let v = if bits >> bit & 1 == 1 { u64::MAX } else { 0 };
+                                    original.bits[bit] = v;
+                                    optimized.bits[bit] = v;
+                                }
+                                let initial = optimized.qubits.clone();
+                                original.apply_iter(original_ops.iter());
+                                optimized.apply_iter(optimized_ops.iter());
+                                assert_eq!(original.qubits,optimized.qubits);
+                                assert_eq!(original.bits,optimized.bits);
+                                assert_eq!(optimized.phase,0);
+                                optimized.apply_iter(optimized_ops.iter().rev());
+                                assert_eq!(optimized.qubits,initial);
+                                checked += 1;
+                            }
+                        }
+                    }
+                }
+            }
+        }
+        assert!(moved > 0);
+        assert_eq!(checked,10880);
+    }
+}
