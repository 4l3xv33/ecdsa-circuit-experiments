+//! Exact retained-AND reuse through five disjoint affine storage routes.
+//!
+//! The preceding circuit is frozen by its operation count and SHA3-256 digest.
+//! For each route, a symbolic pass proves that an HMR's measured value equals
+//! both its immediate CZ correction and a later CCX's product. The later CCX
+//! target is zero. Instead of erasing that value, swaps keep it in borrowed
+//! wires until it replaces the later computation. HMRs and their random-word
+//! order are preserved; the first HMR now measures zero and its CZ is removed.
+//!
+//! A borrowed wire is either zero or an affine parity of unchanged wires.
+//! CNOTs clear that parity before storage and restore it after the handoff.
+//! The planner proves that donors are untouched and parity sources unwritten
+//! during each lease. Handoffs occur outside classical condition blocks.
+//! Each route restores every borrowed wire and removes one unconditional CCX.
+//!
+//! Retained-AND caching follows the technique credited to MonitSharma in the
+//! existing product_cache.rs / retained_and.rs. The affine relay schedules and
+//! their discovery are this experiment's contribution; no approximation or
+//! validation nonce changes are made.
+
+use crate::circuit::{Op, OperationType as K};
+use sha3::{Digest, Sha3_256};
+
+const TABLE: &str = include_str!("relay_cache.txt");
+
+fn fields(o: &Op) -> [u64; 7] {
+    [o.kind as u64, o.q_control2.0, o.q_control1.0, o.q_target.0,
+     o.c_target.0, o.c_condition.0, o.r_target.0]
+}
+
+fn decode(v: &[u64]) -> Op {
+    assert_eq!(v.len(), 7);
+    let mut o = Op::empty();
+    o.kind = match v[0] {
+        0 => K::Neg, 1 => K::Register, 2 => K::AppendToRegister,
+        3 => K::BitInvert, 4 => K::BitStore0, 5 => K::BitStore1,
+        6 => K::X, 7 => K::Z, 8 => K::CX, 9 => K::CZ,
+        10 => K::Swap, 11 => K::R, 12 => K::Hmr, 13 => K::CCX,
+        14 => K::CCZ, 15 => K::PushCondition, 16 => K::PopCondition,
+        17 => K::DebugPrint, _ => panic!("invalid relay row kind"),
+    };
+    o.q_control2.0 = v[1]; o.q_control1.0 = v[2]; o.q_target.0 = v[3];
+    o.c_target.0 = v[4]; o.c_condition.0 = v[5]; o.r_target.0 = v[6];
+    o.validate();
+    o
+}
+
+pub(super) fn run(ops: Vec<Op>) -> Vec<Op> {
+    let mut lines = TABLE.lines();
+    let header: Vec<&str> = lines.next().expect("relay header").split_whitespace().collect();
+    assert_eq!(header.len(), 3);
+    assert_eq!(header[0], "RELAY_CACHE");
+    assert_eq!(ops.len(), header[1].parse::<usize>().unwrap(), "relay source count");
+    let mut hash = Sha3_256::new();
+    for o in &ops {
+        for v in fields(o) { hash.update(v.to_le_bytes()); }
+    }
+    assert_eq!(format!("{:x}", hash.finalize()), header[2], "relay source digest");
+
+    let edits: Vec<Vec<u64>> = lines.map(|line| line.split_whitespace()
+        .map(|x| x.parse::<u64>().expect("relay integer")).collect()).collect();
+    let mut delta = 0isize;
+    let mut previous = None;
+    for e in &edits {
+        assert!(e.len() >= 9);
+        let i = usize::try_from(e[0]).unwrap();
+        assert!(i < ops.len());
+        assert!(previous.map_or(true, |p| p < i), "relay edit order");
+        previous = Some(i);
+        let count = usize::try_from(e[1]).unwrap();
+        assert_eq!(e.len(), 9 + 7 * count);
+        assert_eq!(fields(&ops[i]).as_slice(), &e[2..9], "relay expected source row");
+        delta += count as isize - 1;
+    }
+    assert_eq!(edits.len(), 47);
+    assert_eq!(delta, 64);
+    let mut out = Vec::with_capacity(ops.len().checked_add_signed(delta).unwrap());
+    let mut cursor = 0usize;
+    for (i, o) in ops.into_iter().enumerate() {
+        if cursor < edits.len() && edits[cursor][0] as usize == i {
+            for row in edits[cursor][9..].chunks_exact(7) { out.push(decode(row)); }
+            cursor += 1;
+        } else {
+            out.push(o);
+        }
+    }
+    assert_eq!(cursor, edits.len());
+    eprintln!("RELAY_CACHE routes=5 Toffoli_removed=5 added_qubits=0 op_delta=64");
+    out
+}
