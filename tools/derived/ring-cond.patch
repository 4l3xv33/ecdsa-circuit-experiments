+// Standalone research checks: ID reuse must imply the same truth table.
+pub fn ring_selftest(){
+    let mut v=Vals::new();
+    let mut truth:HashMap<u32,u64>=HashMap::new();truth.insert(ZERO,0);truth.insert(ONE,u64::MAX);
+    let mut pool=vec![(ZERO,0),(ONE,u64::MAX)];
+    for b in 0..6 {let id=v.opq();let mut t=0u64;for x in 0..64{if (x>>b)&1!=0{t|=1<<x;}}truth.insert(id,t);pool.push((id,t));}
+    let mut checks=0;let mut state=0xa6d92bc731e4f805u64;
+    for k in 0..50000{
+        state^=state<<13;state^=state>>7;state^=state<<17;let a=pool[state as usize%pool.len()];
+        state^=state<<13;state^=state>>7;state^=state<<17;let b=pool[state as usize%pool.len()];
+        let (id,t)=if k%2==0{(v.and(a.0,b.0),a.1&b.1)}else{(v.xor(a.0,b.0),a.1^b.1)};
+        if let Some(old)=truth.insert(id,t){assert_eq!(old,t,"ring ID merged unequal functions at {k}");}
+        pool.push((id,t));checks+=64;
+    }
+    let a=pool[2].0;let b=pool[3].0;let c=pool[4].0;
+    let ab=v.and(a,b);let ac=v.and(a,c);let bc=v.xor(b,c);let lhs=v.and(a,bc);let rhs=v.xor(ab,ac);assert_eq!(lhs,rhs);
+    let one_a=v.xor(ONE,a);assert_eq!(v.and(a,one_a),ZERO);
+    let ab_b=v.and(ab,b);assert_eq!(ab_b,ab);
+    let xy=v.xor(ab,ac);let xyz=v.and(xy,xy);assert_eq!(xyz,xy);
+    // The deliberately false identity a*b=a must fail on this exhaustive domain.
+    assert_ne!(truth[&pool[2].0]&truth[&pool[3].0],truth[&pool[2].0]);
+    println!("ring_selftest_truth_evaluations={checks}; Boolean identities and negative control passed; nodes={}",v.node.len());
+}
