+    // Boolean-ring normalization. Unexpanded subexpressions are immutable opaque
+    // atoms. Distribution and x*x=x are exact even when those atoms are dependent.
+    // Caps only reduce precision; they never identify unequal functions.
+    fn terms(&self, a:u32)->Vec<u32>{
+        if a==ZERO {vec![]} else if self.node[a as usize].0==T_SET {
+            self.store[self.node[a as usize].1 as usize].clone()
+        } else {vec![a]}
+    }
+    fn factors(&self,a:u32)->Vec<u32>{
+        if a==ONE {vec![]} else if self.node[a as usize].0==T_MONO {
+            self.mono[self.node[a as usize].1 as usize].clone()
+        } else {vec![a]}
+    }
+    fn monomial(&mut self, fs:Vec<u32>)->u32{
+        if fs.is_empty(){return ONE;} if fs.len()==1{return fs[0];}
+        if let Some(&id)=self.hm.get(&fs){return id;}
+        let si=self.mono.len() as u32;self.mono.push(fs.clone());
+        let id=self.node.len() as u32;self.node.push((T_MONO,si,0));self.hm.insert(fs,id);id
+    }
+    fn poly(&mut self,terms:Vec<u32>)->u32{
+        match terms.len(){
+            0=>ZERO,1=>terms[0],_=>{
+                if let Some(&id)=self.hs.get(&terms){return id;}
+                let si=self.store.len() as u32;self.store.push(terms.clone());
+                let id=self.node.len() as u32;self.node.push((T_SET,si,0));self.hs.insert(terms,id);id
+            }
+        }
+    }
