+// A reversible Clifford clearing of an idle wire: donor XOR parity = constant.
+// Every member is untouched across the proposed hold interval. Restoring the
+// same parity after consuming the held AND therefore restores the donor.
+fn idle_borrow(qv:&[u32], vals:&Vals, touched:&[usize], written:&[usize], since:usize, target:u32)
+ -> Option<(u32,Vec<u32>,bool)> {
+    let idle:Vec<u32>=(512..qv.len()).chain(0..512)
+        .filter(|&q|q as u32!=target && touched[q]<since).map(|q|q as u32).collect();
+    for &q in &idle {if qv[q as usize]<=ONE {return Some((q,vec![],qv[q as usize]==ONE));}}
+    let mut basis:HashMap<u32,(Vec<u32>,Vec<u32>)>=HashMap::new();
+    let stable:Vec<u32>=(0..qv.len()).filter(|&q|q as u32!=target && written[q]<since && touched[q]>=since).map(|q|q as u32).collect();
+    for q in stable.into_iter().chain(idle) {
+        let mut row=vals.atoms(qv[q as usize]);let mut comb=vec![q];
+        while let Some(p)=row.iter().rev().copied().find(|&v|v!=ONE) {
+            if let Some((r,c))=basis.get(&p) {row=symdiff(&row,r);comb=symdiff(&comb,c);}
+            else {break;}
+        }
+        if let Some(p)=row.iter().rev().copied().find(|&v|v!=ONE) {basis.insert(p,(row,comb));}
+        else if touched[q as usize]<since {comb.retain(|&w|w!=q);return Some((q,comb,row.contains(&ONE)));}
+    }
+    None
+}
