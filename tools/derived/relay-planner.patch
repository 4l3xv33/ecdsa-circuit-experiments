+// Plan each exact match independently. Uses inside a classical condition block
+// are charged at its outer PUSH, so every inserted relay occurs outside the
+// block and no stored value is exposed to conditionally executed operations.
+fn relay_plans(ls:&[L], pairs:&[(usize,u32,u32,usize,u32)]) {
+    let nq=1234usize;
+    let mut uses=vec![Vec::<usize>::new();nq];let mut writes=vec![Vec::<usize>::new();nq];let mut depth=0usize;let mut outer=0usize;
+    let mut nested=vec![false;ls.len()];
+    for (k,o) in ls.iter().enumerate() {
+        nested[k]=depth>0;
+        if o.kind==K_PUSH {if depth==0 {outer=k;} depth+=1;}
+        let at=if depth==0 {k}else{outer};
+        for q in [o.c2,o.c1,o.t] {if q!=NQ {
+            let u=&mut uses[q as usize];if u.last()!=Some(&at) {u.push(at);}
+        }}
+        let mut ws=vec![];
+        if matches!(o.kind,K_X|K_CX|K_CCX|K_SWAP|K_R|K_HMR) {ws.push(o.t);}
+        if o.kind==K_SWAP {ws.push(o.c1);}
+        for q in ws {let w=&mut writes[q as usize];if w.last()!=Some(&at) {w.push(at);}}
+        if o.kind==K_POP {depth-=1;}
+    }
+    struct Plan {pair:(usize,u32,u32,usize,u32),holds:Vec<(usize,u32,Vec<u32>,bool)>,release:usize,failed:Option<usize>}
+    let mut plans:Vec<Plan>=pairs.iter().copied().filter(|p|!nested[p.0]&&!nested[p.3]).map(|pair|Plan{pair,holds:vec![],release:0,failed:None}).collect();
+    let mut starts:HashMap<usize,Vec<usize>>=HashMap::new();
+    for (j,p) in plans.iter().enumerate() {starts.entry(p.pair.0).or_default().push(j);}
+    let mut pointers=vec![0usize;nq];let mut next=vec![usize::MAX;nq];
+    let mut wpointers=vec![0usize;nq];let mut next_write=vec![usize::MAX;nq];
+    let mut active:Vec<usize>=vec![];
+    let mut done=0usize;
+    walk(ls, |k,_ctx,qv,vals,_cs,_cx,_bv| {
+        // Only the prior operation's wires can have passed an ordinary use.
+        // At a condition boundary several uses share its outer PUSH timestamp.
+        if starts.contains_key(&k) || active.iter().any(|&j|plans[j].release<=k || plans[j].pair.3==k) {
+            for q in 0..nq {while pointers[q]<uses[q].len()&&uses[q][pointers[q]]<k {pointers[q]+=1;} next[q]=uses[q].get(pointers[q]).copied().unwrap_or(usize::MAX);}
+            for q in 0..nq {while wpointers[q]<writes[q].len()&&writes[q][wpointers[q]]<k {wpointers[q]+=1;} next_write[q]=writes[q].get(wpointers[q]).copied().unwrap_or(usize::MAX);}
+        }
+        if let Some(js)=starts.get(&k) {active.extend(js);}
+        let mut keep=Vec::with_capacity(active.len());
+        for &j in &active {
+            let p=&mut plans[j];
+            if p.pair.3==k {done+=1;println!("RELAY_HIT hmr={} wire={} bit={} ccx={} target={} hops={} holds={:?}",p.pair.0,p.pair.1,p.pair.2,p.pair.3,p.pair.4,p.holds.len(),p.holds);continue;}
+            if p.release<=k {
+                assert!(!nested[k],"relay inside a condition block");
+                let old=p.holds.last().map(|h|h.1 as usize);
+                let old_parity=p.holds.last().map(|h|h.2.clone()).unwrap_or_default();
+                let donor=(0..nq).filter(|&q|Some(q)!=old && !old_parity.contains(&(q as u32)) && next[q]>k && qv[q]<=ONE).max_by_key(|&q|next[q]);
+                if let Some(q)=donor {p.holds.push((k,q as u32,vec![],qv[q]==ONE));p.release=next[q];}
+                else {
+                    let find=|horizon:usize|->Option<(u32,Vec<u32>,bool)> {
+                        let stable:Vec<u32>=(0..nq).filter(|&q|Some(q)!=old&&next_write[q]>=horizon).map(|q|q as u32).collect();
+                        let can_donate=|q:u32|next[q as usize]>=horizon&&!old_parity.contains(&q);
+                        let mut order:Vec<u32>=stable.iter().copied().filter(|&q|!can_donate(q)).collect();
+                        order.extend(stable.iter().copied().filter(|&q|can_donate(q)));
+                        let mut basis:HashMap<u32,(Vec<u32>,Vec<u32>)>=HashMap::new();
+                        for q in order {
+                            let mut row=vals.atoms(qv[q as usize]);let mut comb=vec![q];
+                            while let Some(pivot)=row.iter().rev().copied().find(|&a|a!=ONE) {
+                                if let Some((r,c))=basis.get(&pivot) {row=symdiff(&row,r);comb=symdiff(&comb,c);} else {break;}
+                            }
+                            if let Some(pivot)=row.iter().rev().copied().find(|&a|a!=ONE) {basis.insert(pivot,(row,comb));}
+                            else if can_donate(q) {comb.retain(|&w|w!=q);return Some((q,comb,row.contains(&ONE)));}
+                        }
+                        None
+                    };
+                    let mut horizons:Vec<usize>=next.iter().chain(next_write.iter()).copied().filter(|&v|v>k).collect();horizons.sort_unstable();horizons.dedup();
+                    let(mut lo,mut hi)=(0,horizons.len());let mut best=None;
+                    while lo<hi {let mid=(lo+hi)/2;if let Some(v)=find(horizons[mid]) {best=Some(v);lo=mid+1;}else{hi=mid;}}
+                    if let Some((q,parity,constant))=best {
+                        p.release=parity.iter().fold(next[q as usize],|v,&w|v.min(next_write[w as usize]));
+                        p.holds.push((k,q,parity,constant));
+                    } else {p.failed=Some(k);continue;}
+                }
+            }
+            keep.push(j);
+        }
+        active=keep;
+    });
+    let earliest=plans.iter().filter_map(|p|p.failed.map(|f|(f-p.pair.0,p.pair.0,f))).min();
+    println!("RELAY_SUM pairs={} completed={done} earliest_failure={earliest:?}",plans.len());
+}
