+pub fn lifetime_census(ops: &[Op]) {
+    let ls:Vec<L> = ops.iter().map(to_l).collect();
+    let nq=1234usize;
+    let mut old=vec![ZERO;nq];
+    for q in 0..512 {old[q]=2;}
+    let mut unknown=0usize;
+    let mut peak=512usize;
+    let mut at=0usize;
+    let mut peak_zero=512usize;
+    let mut unknown_zero=0usize;
+    let mut last=0usize;
+    let mut values:HashMap<u32,(usize,usize)>=HashMap::new();
+    let mut distinct=0usize;
+    let mut peak_distinct=512usize;
+    let mut distinct_at=0usize;
+    let mut pair_values:HashMap<usize,(u32,u32)>=HashMap::new();
+    let mut touched=vec![0usize;nq];
+    let mut written=vec![0usize;nq];
+    let mut measured:HashMap<u32,(usize,u32,u32)>=HashMap::new();
+    let mut pending:Option<(usize,u32,u32,u32)>=None;
+    let mut cache_matches=0usize;let mut cache_hits=0usize;
+    let mut relay_candidates=vec![];
+    walk(&ls, |k,ctx,qv,vals,_cs,_cx,_bv| {
+        if k>0 {
+            let p=ls[k-1];for q in [p.c2,p.c1,p.t] {if q!=NQ {touched[q as usize]=k-1;}}
+            if matches!(p.kind,K_X|K_CX|K_CCX|K_SWAP|K_R|K_HMR) {written[p.t as usize]=k-1;}
+            if p.kind==K_SWAP {written[p.c1 as usize]=k-1;}
+        }
+        let o=ls[k];
+        if let Some((h,w,bit,value))=pending.take() {
+            if o.kind==9 && o.cc==bit && existing_product(vals,qv[o.c1 as usize],qv[o.t as usize])==Some(value) {
+                measured.insert(value,(h,w,bit));
+            }
+        }
+        if o.kind==K_HMR && ctx.is_empty() && qv[o.t as usize]>ONE {
+            pending=Some((k,o.t,o.ct,qv[o.t as usize]));
+        }
+        if o.kind==K_CCX && ctx.is_empty() && qv[o.t as usize]==ZERO {
+            if let Some(value)=existing_product(vals,qv[o.c1 as usize],qv[o.c2 as usize]) {
+                if let Some(&(h,w,bit))=measured.get(&value) {
+                    cache_matches+=1;
+                    relay_candidates.push((h,w,bit,k,o.t));
+                    println!("EXACT_CACHE_MATCH hmr={h} wire={w} bit={bit} ccx={k} target={} distance={}",o.t,k-h);
+                    if cache_hits<24 {
+                        if let Some((donor,parity,constant))=idle_borrow(qv,vals,&touched,&written,h,o.t) {
+                            cache_hits+=1;
+                            println!("EXACT_CACHE hmr={h} wire={w} bit={bit} ccx={k} target={} donor={donor} parity={parity:?} constant={constant}",o.t);
+                        }
+                    }
+                }
+            }
+        }
+        if [4550376,5134780].contains(&k) {
+            let o=ls[k];pair_values.insert(k,(qv[o.c2 as usize],qv[o.c1 as usize]));
+        }
+        if let Some(left)=match k {4551653=>Some(4550376),5136057=>Some(5134780),_=>None} {
+            let (x,y)=pair_values[&left];let o=ls[k];let z=qv[o.c2 as usize];let b=qv[o.c1 as usize];
+            let xy=symdiff(&vals.atoms(x),&vals.atoms(y));
+            let relation=xy==vals.atoms(b);
+            let delta=symdiff(&vals.atoms(x),&vals.atoms(z));
+            let (hit,lev,capped)=span(&delta,qv,vals,o.t,2000,2000);
+            println!("PAIR_PROOF left={left} right={k} carry_relation={relation} delta_atoms={} hit={hit:?} lev={lev} capped={capped}",delta.len());
+        }
+        if k==0 {
+            old.clone_from_slice(qv);
+            for (q,&v) in qv.iter().enumerate(){if v>ONE {
+                let e=values.entry(v).or_default();if q<512 {e.0+=1;}else{e.1+=1;}
+            }}
+            distinct=values.values().filter(|e|e.0==0 && e.1>0).count();
+        }
+        if k>0 {
+            let p=ls[k-1];
+            let mut changed=vec![p.c2,p.c1,p.t]; changed.sort_unstable();changed.dedup();
+            for q in changed {if q!=NQ {
+                let q=q as usize; let was=old[q]; let now=qv[q];
+                if was!=now {
+                    if was>ONE {
+                        let e=values.get_mut(&was).unwrap();
+                        distinct-=usize::from(e.0==0 && e.1>0);
+                        if q<512 {e.0-=1;}else{e.1-=1;}
+                        distinct+=usize::from(e.0==0 && e.1>0);
+                        if e.0+e.1==0 {values.remove(&was);}
+                    }
+                    if now>ONE {
+                        let e=values.entry(now).or_default();
+                        distinct-=usize::from(e.0==0 && e.1>0);
+                        if q<512 {e.0+=1;}else{e.1+=1;}
+                        distinct+=usize::from(e.0==0 && e.1>0);
+                    }
+                }
+                if q>=512 {
+                unknown=unknown + usize::from(now>ONE) - usize::from(was>ONE);
+                unknown_zero=unknown_zero + usize::from(now!=ZERO) - usize::from(was!=ZERO);
+                }
+                old[q]=now;
+            }}
+        }
+        let o=ls[k];let mut touched=vec![o.c2,o.c1,o.t];touched.sort_unstable();touched.dedup();
+        let constants=touched.iter().filter(|&&q| q!=NQ && q>=512 && qv[q as usize]<=ONE).count();
+        let zeros=touched.iter().filter(|&&q| q!=NQ && q>=512 && qv[q as usize]==ZERO).count();
+        let width=512+unknown+constants;
+        if 512+distinct>peak_distinct {peak_distinct=512+distinct;distinct_at=k;}
+        if width>peak {peak=width;at=k;}
+        peak_zero=peak_zero.max(512+unknown_zero+zeros);
+        if k-last>=1000000 {eprintln!("lifetime progress op={k} nodes={} peak={peak} at={at}",vals.node.len());last=k;}
+    });
+    println!("EXACT_CONSTANT_LIFETIMES peak={peak} at={at} zeros_only_peak={peak_zero} distinct_value_peak={peak_distinct} at={distinct_at}");
+    println!("EXACT_CACHE_SUM value_matches={cache_matches} hits_up_to_24={cache_hits}");
+    relay_plans(&ls,&relay_candidates);
+}
