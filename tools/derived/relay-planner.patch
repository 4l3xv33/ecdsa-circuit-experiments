+fn existing_product(v:&Vals,a:u32,b:u32)->Option<u32> {
+    if a==ZERO || b==ZERO {Some(ZERO)}
+    else if a==ONE || a==b {Some(b)} else if b==ONE {Some(a)}
+    else {v.h.get(&(T_AND,a.min(b),a.max(b))).copied()}
+}
