+fn main(){
+ let args:Vec<String>=std::env::args().collect();assert_eq!(args.len(),3,"circuit packet-source|fresh|official");
+ let ops=load_ops(&args[1]).unwrap();let(nq,nb,_,regs)=analyze_ops(ops.iter());
+ let seed=match args[2].as_str(){
+  "fresh"=>{let mut h=Shake256::default();h.update(b"ecdsafail-affine-relay-common-v1-20261029-0608");h.finalize_xof()},
+  "official"=>fiat_shamir_seed(&ops),
+  path=>fiat_shamir_seed(&load_ops(path).unwrap()),
+ };
+ let r=run_tests(&ops,&regs,nq,nb,seed,9024);
+ println!("{{\"packet_source\":\"{}\",\"passed\":{},\"shots\":{},\"qubits\":{nq},\"operations\":{},\"average_toffoli\":{},\"average_clifford\":{},\"rounded_diagnostic_product\":{},\"classical_errors\":{},\"phase_error_batches\":{},\"ancilla_error_batches\":{},\"official_score\":null}}",args[2],r.ok,r.n_shots,ops.len(),r.avg_tof,r.avg_cliff,(r.avg_tof.round()as u64)*nq,r.classical_failures,r.phase_garbage_batches,r.ancilla_garbage_batches);
+}
